<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The package under test is restored from the local pack output, not from nuget.org. -->
  <packageSources>
    <clear />
    <add key="local" value="..\..\nugets" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
