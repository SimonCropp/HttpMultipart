<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compile-only. What it proves is that the packed nupkg produces a project that builds, under
         the strictest settings a consumer is likely to have. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Not managed centrally: the version floats onto whatever pack just produced. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HttpMultipart" Version="*-*" PrivateAssets="all" />
  </ItemGroup>
</Project>
