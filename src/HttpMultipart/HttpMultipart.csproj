<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compiled only to type-check the sources. The nuspec <files> list is an allowlist that never
         mentions lib/, so the resulting assembly is discarded at pack time. -->
    <TargetFramework>net10.0</TargetFramework>
    <NuSpecFile>HttpMultipart.nuspec</NuSpecFile>
    <Authors>Simon Cropp</Authors>
    <PackageProjectUrl>https://github.com/SimonCropp/HttpMultipart</PackageProjectUrl>
    <PackStageDir>$(BaseIntermediateOutputPath)pack/</PackStageDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- ExcludeAssets drops ProjectDefaults' injected global-usings file. Without that, these sources
         would compile against usings a consumer does not have, and the omission would only surface
         once the package was published. -->
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" ExcludeAssets="contentFiles" />
    <!-- The files that ship. Globbed without recursion so nothing generated under obj can reach the
         package. -->
    <PackSource Include="$(MSBuildProjectDirectory)/*.cs" />
  </ItemGroup>

  <!-- _GetOutputItemsFromPack also reads NuspecProperties to resolve the package id/version out of the
       nuspec, so the tokens have to be substituted before it runs, not just before GenerateNuspec. -->
  <Target Name="SetPackageDependencies" BeforeTargets="GenerateNuspec;_GetOutputItemsFromPack">
    <PropertyGroup>
      <!-- A wildcard in a nuspec <file src> is matched with the platform's directory separator, so a
           path written with forward slashes silently matches nothing on Windows. NormalizeDirectory
           hands the nuspec a path with the right separator for wherever pack is running. -->
      <PackStagePath>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PackStageDir)'))</PackStagePath>
      <NuspecProperties>version=$(PackageVersion);authors=$(Authors);projectUrl=$(PackageProjectUrl);description=$(Description);tags=$(PackageTags);copyright=$(Copyright);sources=$(PackStagePath)*.cs</NuspecProperties>
    </PropertyGroup>
  </Target>

  <!-- Consumers compile these files with their own analyzer settings, and both of the projects this
       package was extracted from build with TreatWarningsAsErrors. Shipped source therefore carries a
       suppression header, while the authored files in this repo stay analyzer-clean. #nullable enable
       matters independently: without it a consumer with <Nullable>disable</Nullable> gets CS8632 on
       every annotation. -->
  <UsingTask TaskName="StageSourceForPack"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string header = "// <auto-generated />\n#pragma warning disable\n#nullable enable\n\n";
        System.IO.Directory.CreateDirectory(Destination);
        foreach (var source in Sources)
        {
            var target = System.IO.Path.Combine(Destination, System.IO.Path.GetFileName(source.ItemSpec));
            var content = header + System.IO.File.ReadAllText(source.ItemSpec).Replace("\r\n", "\n");
            if (!System.IO.File.Exists(target) || System.IO.File.ReadAllText(target) != content)
            {
                System.IO.File.WriteAllText(target, content);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StageSource" BeforeTargets="GenerateNuspec;Build">
    <StageSourceForPack Sources="@(PackSource)" Destination="$(MSBuildProjectDirectory)/$(PackStageDir)" />
  </Target>
</Project>
