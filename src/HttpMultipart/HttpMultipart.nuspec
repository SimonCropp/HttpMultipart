<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>HttpMultipart</id>
    <version>$version$</version>
    <authors>$authors$</authors>
    <developmentDependency>true</developmentDependency>
    <license type="expression">MIT</license>
    <projectUrl>$projectUrl$</projectUrl>
    <icon>icon.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>$description$</description>
    <copyright>$copyright$</copyright>
    <tags>$tags$</tags>
    <readme>readme.md</readme>
  </metadata>
  <files>
    <file src="../nuget-readme.md" target="readme.md" />
    <file src="../icon.png" target="icon.png" />
    <file src="$sources$" target="contentFiles/cs/net10.0/HttpMultipart/" />
    <file src="build/HttpMultipart.props" target="build/" />
    <file src="build/HttpMultipart.targets" target="build/" />
    <file src="exclude.editorconfig" target=".editorconfig" />
  </files>
</package>
