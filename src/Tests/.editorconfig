root = false

[*.cs]
# ProjectDefaults declares the Cancel alias for CancellationToken and inspects for its use, but this
# project removes the alias: these files ship as source and a consumer will not have it. Spelling the
# type in full is required here, so the suggestion is wrong for this folder only.
resharper_use_symbol_alias_highlighting = none

# The only read of 'read' in MultipartReaderStream.ReadBoundaryAsync is a Debug.Assert, which is
# [Conditional("DEBUG")], so under a Release analysis the assignment has no reader at all. The assert
# is upstream's and these files are kept diffable against aspnetcore, so it stays.
resharper_redundant_assignment_highlighting = none
